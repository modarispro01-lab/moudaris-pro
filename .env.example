# ======= Modaris Pro — نموذج متغيّرات البيئة =======
# انسخ هذا الملف إلى .env (محلياً) وأضف نفس القيم في Vercel → Settings → Environment Variables.

# قاعدة البيانات (PostgreSQL / Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Vercel Blob (رفع الملفات)
BLOB_READ_WRITE_TOKEN=""

# ======= Google AdSense =======
# معرّف الناشر الذي يعطيك إياه أدسنس بعد إنشاء الحساب.
# يُستعمل تلقائياً في كود الإعلانات (AdSense.tsx) وفي ملف /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=""
